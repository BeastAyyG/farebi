# Base URL of the Farebi API.
# Leave EMPTY in development: the browser then calls same-origin `/v1/detect`
# and Vite proxies it to VITE_DEV_PROXY_TARGET. This is what keeps the app
# working behind a remote preview host, where `localhost` is the user's machine.
VITE_API_BASE=

# Where the Vite dev server forwards /v1, /health and /ready.
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8000

# Serve fixture responses instead of calling the API. Adds a scenario picker
# to the header so every verdict and error state is demoable with no backend.
VITE_MOCK_API=true

# Client-side request timeout in milliseconds (frebi.md §9.2).
VITE_REQUEST_TIMEOUT_MS=30000

# Upload pre-checks. The API remains authoritative; these only give the
# reviewer a faster, more specific rejection.
VITE_MAX_UPLOAD_BYTES=10485760
VITE_MAX_PIXEL_DIM=2048
