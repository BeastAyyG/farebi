# Farebi environment overrides.
#
# Every value here overrides the matching key in configs/*.yaml.
# The prefix is FAREBI_ and nesting uses a double underscore, e.g.
#   FAREBI_APP__LOG_LEVEL=DEBUG
#   FAREBI_UPLOAD__MAX_BYTES=8388608
#
# Nothing in this file is a secret. Do not put secrets in configs/ either.

# --- app ------------------------------------------------------------------
FAREBI_APP__ENV=development
FAREBI_APP__LOG_LEVEL=INFO
FAREBI_APP__LOG_FORMAT=json

# --- upload / retention ---------------------------------------------------
# Uploads are never retained by default (FAREBI.md non-negotiable #7).
FAREBI_APP__RETENTION__KEEP_UPLOADS=false

# --- capture --------------------------------------------------------------
# Set to false to run the pipeline without MediaPipe (degraded CI mode).
FAREBI_CAPTURE__FACE_MESH__ENABLED=true

# auto | solutions | tasks. "tasks" needs the model asset below; fetch it with:
#   python scripts/fetch_face_landmarker.py
FAREBI_CAPTURE__FACE_MESH__BACKEND=auto
FAREBI_CAPTURE__FACE_MESH__MODEL_PATH=artifacts/models/face_landmarker.task

# --- artifacts ------------------------------------------------------------
FAREBI_ARTIFACTS__DIR=artifacts
